{
  "name": "omp-provider-sub2api",
  "version": "0.4.2",
  "description": "OMP-native multi-key model-pool router derived from @indexyz/pi-provider-sub2api.",
  "type": "module",
  "license": "MIT",
  "author": "HayabusaC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HayabusaC/omp-provider-sub2api.git"
  },
  "homepage": "https://github.com/HayabusaC/omp-provider-sub2api#readme",
  "bugs": { "url": "https://github.com/HayabusaC/omp-provider-sub2api/issues" },
  "keywords": ["oh-my-pi", "omp", "sub2api", "multi-key", "llm-provider"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc --noEmit"
  },
  "omp": {
    "extensions": ["./omp-index.ts"],
    "settings": {
      "providerId": {
        "type": "string",
        "default": "sub2api",
        "description": "OMP provider ID for the merged model pool."
      },
      "baseURL": {
        "type": "string",
        "default": "",
        "description": "Sub2API service base URL (with or without /v1)."
      },
      "api": {
        "type": "enum",
        "values": ["auto", "openai-responses", "openai-completions", "anthropic-messages"],
        "default": "auto",
        "description": "Transport for discovered models; auto routes Claude to Anthropic, GPT/Codex to Responses, and others to Chat Completions."
      }
    }
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^18.2.10",
    "@oh-my-pi/pi-catalog": "^18.2.10",
    "@oh-my-pi/pi-coding-agent": "^18.2.10"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.2.10",
    "@oh-my-pi/pi-catalog": "18.2.10",
    "@oh-my-pi/pi-coding-agent": "18.2.10",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "files": [
    "omp-index.ts",
    "omp-pool.ts",
    "pricing.ts",
    "README.md",
    "README.zh-CN.md",
    "UPSTREAM.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
